<resources>
    <style name="Title"><item name="android:fontFamily">sans-serif-medium</item><item name="android:textColor">@color/paper</item><item name="android:textSize">34sp</item><item name="android:lineSpacingExtra">0dp</item><item name="android:includeFontPadding">false</item><item name="android:letterSpacing">-0.035</item></style>
    <style name="Body"><item name="android:fontFamily">sans-serif</item><item name="android:textColor">@color/muted</item><item name="android:textSize">14sp</item><item name="android:lineSpacingExtra">4dp</item></style>
    <style name="Eyebrow"><item name="android:fontFamily">sans-serif-medium</item><item name="android:textColor">@color/muted</item><item name="android:textSize">10sp</item><item name="android:letterSpacing">0.16</item></style>
    <style name="PrimaryButton" parent="Widget.AppCompat.Button"><item name="android:background">@drawable/button_primary</item><item name="backgroundTint">@null</item><item name="android:backgroundTint">@null</item><item name="android:textColor">@color/button_text</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">15sp</item><item name="android:textAllCaps">false</item><item name="android:minHeight">56dp</item><item name="android:stateListAnimator">@null</item><item name="android:paddingHorizontal">22dp</item></style>
    <style name="SecondaryButton" parent="PrimaryButton"><item name="android:background">@drawable/button_secondary</item><item name="android:textColor">@color/paper</item></style>
    <style name="IconButton"><item name="android:background">@drawable/button_icon</item><item name="android:padding">13dp</item><item name="android:tint">@color/paper</item><item name="android:scaleType">centerInside</item></style>
    <style name="TrackAction"><item name="android:background">@drawable/button_icon</item><item name="android:padding">13dp</item><item name="android:tint">@color/muted</item><item name="android:scaleType">centerInside</item></style>
    <style name="StepText" parent="Body"><item name="android:textColor">@color/paper</item><item name="android:textSize">14sp</item></style>
</resources>