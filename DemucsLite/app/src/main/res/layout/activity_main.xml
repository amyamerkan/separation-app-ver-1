<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/appRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ink">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="24dp">
        <ImageButton android:id="@+id/btnBack" style="@style/IconButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_arrow_left" android:contentDescription="@string/ui_a11y_btnback" android:visibility="gone" />
        <ImageView android:id="@+id/brandIcon" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_brand" android:importantForAccessibility="no" />
        <TextView android:id="@+id/toolbarTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="@string/ui_toolbartitle" android:textColor="@color/paper" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.035" />
        <ImageButton android:id="@+id/btnSettings" style="@style/IconButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_settings" android:contentDescription="@string/ui_a11y_btnsettings" />
    </LinearLayout>
    <FrameLayout android:id="@+id/screenContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <include android:id="@+id/screenHome" layout="@layout/screen_home" />
        <include android:id="@+id/screenUpload" layout="@layout/screen_upload" android:visibility="gone" />
        <include android:id="@+id/screenProcessing" layout="@layout/screen_processing" android:visibility="gone" />
        <include android:id="@+id/screenMixer" layout="@layout/screen_mixer" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="70dp" android:gravity="center" android:paddingHorizontal="24dp" android:background="@color/ink">
        <TextView android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="@string/ui_navhome" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="@color/purple" android:paddingHorizontal="18dp" android:background="@drawable/pill" android:clickable="true" android:focusable="true" app:drawableStartCompat="@drawable/ic_home" app:drawableTint="@color/purple" />
        <Space android:layout_width="12dp" android:layout_height="1dp" />
        <TextView android:id="@+id/navStudio" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:text="@string/ui_navstudio" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="@color/muted" android:paddingHorizontal="18dp" android:background="@drawable/button_icon" android:clickable="true" android:focusable="true" app:drawableStartCompat="@drawable/ic_sliders" app:drawableTint="@color/muted" />
    </LinearLayout>
</LinearLayout>