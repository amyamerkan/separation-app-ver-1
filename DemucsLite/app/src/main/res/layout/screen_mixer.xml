<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="16dp" android:paddingBottom="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_03_your_mix" android:textSize="10sp" android:textColor="@color/purple" android:background="@drawable/pill" android:paddingHorizontal="12dp" android:paddingVertical="7dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.05" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/resultBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_resultbadge" android:textColor="@color/mint" android:textSize="9sp" android:letterSpacing="0.06" />
        </LinearLayout>
        <Space android:layout_width="1dp" android:layout_height="18dp" />
        <TextView style="@style/Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/mixer_title" />
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView android:layout_width="46dp" android:layout_height="46dp" android:padding="11dp" android:src="@drawable/ic_brand" android:background="@drawable/icon_tile" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:id="@+id/mixerFileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/paper" android:maxLines="2" android:ellipsize="end" />
                    <TextView android:id="@+id/mixerMeta" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" />
                </LinearLayout>
                <ImageButton android:id="@+id/btnPlayAll" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/pill_mint" android:padding="15dp" android:src="@drawable/ic_play" android:contentDescription="@string/ui_a11y_btnplayall" />
            </LinearLayout>
            <SeekBar android:id="@+id/playbackSeek" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="10dp" android:progressDrawable="@drawable/seek_progress" android:thumb="@drawable/seek_thumb" android:splitTrack="false" android:paddingHorizontal="8dp" android:contentDescription="@string/ui_a11y_playbackseek" android:saveEnabled="false" android:minHeight="4dp" android:maxHeight="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/currentTime" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_currenttime" android:textColor="@color/muted" android:textSize="10sp" />
                <TextView android:id="@+id/totalTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_currenttime" android:textColor="@color/muted" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_ban_phoi_am" style="@style/Eyebrow" />
            <TextView android:id="@+id/btnResetMix" android:layout_width="wrap_content" android:layout_height="48dp" android:paddingHorizontal="8dp" android:gravity="center" android:text="@string/ui_btnresetmix" android:textSize="12sp" android:textColor="@color/purple" android:clickable="true" android:focusable="true" />
        </LinearLayout>
        <include android:id="@+id/trackVocals" layout="@layout/item_stem" />
        <include android:id="@+id/trackDrums" layout="@layout/item_stem" />
        <include android:id="@+id/trackBass" layout="@layout/item_stem" />
        <include android:id="@+id/trackOther" layout="@layout/item_stem" />
        <TextView style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_keo_slider_e_chinh_am_luong_cham_s_e_nghe_rieng_mot_track" />
        <Space android:layout_width="1dp" android:layout_height="20dp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnExport" style="@style/PrimaryButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/ui_btnexport" android:background="@drawable/button_mint" />
        <Space android:layout_width="1dp" android:layout_height="10dp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnNewSong" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/ui_btnnewsong" />
        <Space android:layout_width="1dp" android:layout_height="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_wav_goc_slider_chi_ieu_chinh_khi_nghe" android:textSize="11sp" android:textColor="@color/muted" android:layout_gravity="center_horizontal" />
    </LinearLayout>
</ScrollView>