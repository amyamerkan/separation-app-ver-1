# For Docker Compose: copy this file to .env next to compose.yaml.
API_PORT=8000
MODEL_DEVICE=cpu
MAX_UPLOAD_MB=50
INFERENCE_OVERLAP=0.5
# Empty = infer download URL from the upload request host.
# Behind an HTTPS reverse proxy, set the actual public origin, e.g. https://api.example.com
PUBLIC_BASE_URL=
